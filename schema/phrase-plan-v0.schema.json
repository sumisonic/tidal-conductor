{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "energy",
    "bars",
    "slots"
  ],
  "properties": {
    "version": {
      "type": "number",
      "enum": [
        0
      ]
    },
    "energy": {
      "type": "number",
      "description": "a number between 0 and 1",
      "title": "between(0, 1)",
      "minimum": 0,
      "maximum": 1
    },
    "bars": {
      "type": "number",
      "enum": [
        1,
        2,
        4
      ]
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slot",
          "role",
          "rhythm"
        ],
        "properties": {
          "slot": {
            "type": "integer",
            "description": "a number between 1 and 8",
            "title": "between(1, 8)",
            "minimum": 1,
            "maximum": 8
          },
          "role": {
            "type": "string",
            "enum": [
              "kick",
              "snare",
              "hat",
              "perc",
              "bass",
              "stab",
              "noise"
            ]
          },
          "rhythm": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "pulses",
                  "steps"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "euclid"
                    ]
                  },
                  "pulses": {
                    "type": "integer",
                    "description": "a number between 1 and 16",
                    "title": "between(1, 16)",
                    "minimum": 1,
                    "maximum": 16
                  },
                  "steps": {
                    "type": "integer",
                    "description": "a number between 2 and 16",
                    "title": "between(2, 16)",
                    "minimum": 2,
                    "maximum": 16
                  },
                  "rotation": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "description": "a number between 0 and 15",
                        "title": "between(0, 15)",
                        "minimum": 0,
                        "maximum": 15
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "description": "a number between 0 and 15",
                          "title": "between(0, 15)",
                          "minimum": 0,
                          "maximum": 15
                        },
                        "description": "an array of at most 4 item(s)",
                        "title": "maxItems(4)",
                        "minItems": 2,
                        "maxItems": 4
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "variants"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "grid"
                    ]
                  },
                  "variants": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "x",
                              "~"
                            ]
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "x",
                                "~"
                              ]
                            },
                            "description": "an array of at most 4 item(s)",
                            "title": "maxItems(4)",
                            "minItems": 2,
                            "maxItems": 4
                          }
                        ]
                      },
                      "description": "an array of at most 32 item(s)",
                      "title": "maxItems(32)",
                      "minItems": 2,
                      "maxItems": 32
                    },
                    "description": "an array of at most 4 item(s)",
                    "title": "maxItems(4)",
                    "minItems": 1,
                    "maxItems": 4
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "silence"
                    ]
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "description": "an array of at most 8 item(s)",
      "title": "maxItems(8)",
      "minItems": 1,
      "maxItems": 8
    }
  },
  "additionalProperties": false
}
