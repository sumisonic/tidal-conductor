# Copy to .env and fill in what you use. The pnpm scripts load a .env next to
# package.json automatically (scripts/env.mjs); nothing is printed when it is
# absent. All keys are optional: the default Brain (pool) needs none of them.
#
# api Brain (AI_BRAIN=api). Pick a provider with AI_PROVIDER=google|anthropic|openai.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
#
# local Brain (AI_BRAIN=local, experimental). Ollama's OpenAI-compatible endpoint.
# AI_LOCAL_URL=http://127.0.0.1:11434/v1
# AI_LOCAL_MODEL=<your-model-name>
